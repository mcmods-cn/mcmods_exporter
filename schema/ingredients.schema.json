{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mcmod.cn/schemas/mcmods-ingredients-v1.json",
  "title": "MC Wiki normalized non-item ingredients",
  "type": "object",
  "required": ["schema_version", "type_count", "ingredient_count", "types"],
  "properties": {
    "schema_version": { "const": "mcmods-ingredients/v1" },
    "type_count": { "type": "integer", "minimum": 0 },
    "ingredient_count": { "type": "integer", "minimum": 0 },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ingredient_type", "ingredient_kind", "path_key", "count", "entries"],
        "properties": {
          "ingredient_type": { "type": "string", "minLength": 1 },
          "ingredient_kind": {
            "enum": ["fluid", "mekanism_gas", "mekanism_infuse_type", "mekanism_pigment", "mekanism_slurry", "custom"]
          },
          "chemical_family": { "enum": ["mekanism"] },
          "chemical_type": { "enum": ["gas", "infuse_type", "pigment", "slurry", "unknown"] },
          "path_key": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "count": { "type": "integer", "minimum": 0 },
          "entries": {
            "type": "array",
            "items": { "$ref": "#/$defs/ingredient" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "required": ["ingredient_kind", "resource_location", "unique_id", "names", "tags", "icons"],
      "properties": {
        "ingredient_kind": {
          "enum": ["fluid", "mekanism_gas", "mekanism_infuse_type", "mekanism_pigment", "mekanism_slurry", "custom"]
        },
        "chemical_family": { "enum": ["mekanism"] },
        "chemical_type": { "enum": ["gas", "infuse_type", "pigment", "slurry", "unknown"] },
        "resource_location": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
        "unique_id": { "type": "string", "minLength": 1 },
        "translation_key": { "type": "string" },
        "amount": { "type": "integer", "minimum": 0 },
        "names": { "type": "object", "additionalProperties": { "type": "string" } },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "icons": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "\\.png$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
