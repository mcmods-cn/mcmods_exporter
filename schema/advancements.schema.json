{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mcmod.cn/schemas/mcmods-advancements-v1.json",
  "title": "MC百科进度/成就网",
  "type": "object",
  "required": ["schema_version", "source", "count", "language_count", "roots", "advancements"],
  "properties": {
    "schema_version": { "const": "mcmods-advancements/v1" },
    "source": { "enum": ["integrated_server", "client_sync"] },
    "count": { "type": "integer", "minimum": 0 },
    "language_count": { "type": "integer", "minimum": 1 },
    "roots": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "advancements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "children", "criteria", "requirements", "max_criteria_required", "rewards"],
        "properties": {
          "id": { "type": "string" },
          "parent": { "type": "string" },
          "children": { "type": "array", "items": { "type": "string" } },
          "display": {
            "type": "object",
            "properties": {
              "title_names": { "$ref": "#/$defs/localized" },
              "description_names": { "$ref": "#/$defs/localized" },
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "additionalProperties": true
          },
          "criteria": { "type": "array", "items": { "type": "string" } },
          "requirements": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" } }
          },
          "max_criteria_required": { "type": "integer", "minimum": 0 },
          "rewards": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}
