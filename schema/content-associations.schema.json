{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mcmod.cn/schemas/mcmods-content-associations-v1.json",
  "oneOf": [
    { "$ref": "#/$defs/machines" },
    { "$ref": "#/$defs/trades" }
  ],
  "$defs": {
    "machines": {
      "type": "object",
      "required": ["schema_version", "count", "recipe_type_relations", "machines"],
      "properties": {
        "schema_version": { "const": "mcmods-machines/v1" },
        "count": { "type": "integer", "minimum": 0 },
        "recipe_type_relations": { "type": "string" },
        "machines": { "type": "array" }
      },
      "additionalProperties": true
    },
    "trades": {
      "type": "object",
      "required": ["schema_version", "source", "complete", "sampling_note", "profession_count", "professions"],
      "properties": {
        "schema_version": { "const": "mcmods-villager-trades/v1" },
        "source": { "enum": ["runtime_item_listing_sample", "unavailable"] },
        "complete": { "const": false },
        "sampling_note": { "type": "string" },
        "profession_count": { "type": "integer", "minimum": 0 },
        "professions": { "type": "array" }
      },
      "additionalProperties": true
    }
  }
}
