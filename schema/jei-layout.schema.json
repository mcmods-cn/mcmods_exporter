{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mcmod.cn/schemas/mcmods-jei-layout-collection-v1.json",
  "title": "MC百科 JEI 可交互配方布局集合",
  "type": "object",
  "required": ["schema_version", "recipe_type_id", "count", "layouts"],
  "properties": {
    "schema_version": { "const": "mcmods-jei-layout-collection/v1" },
    "recipe_type_id": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "layouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/layout" }
    }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "required": ["schema_version", "recipe_type_id", "recipe_id", "recipe_id_source", "recipe_id_canonical", "layout_key", "render_locale", "background", "background_contains_ingredients", "coordinate_space", "image_scale", "canvas", "content", "parameter_count", "parameters", "slots"],
      "properties": {
        "schema_version": { "const": "mcmods-jei-layout/v4" },
        "recipe_type_id": { "type": "string" },
        "recipe_id": { "type": "string" },
        "recipe_id_source": { "enum": ["minecraft_recipe", "jei_category", "generated_index"] },
        "recipe_id_canonical": { "type": "boolean" },
        "layout_key": { "type": "string" },
        "render_locale": { "type": "string" },
        "background": { "type": "string" },
        "background_contains_ingredients": { "const": false },
        "coordinate_space": { "const": "logical_pixels" },
        "image_scale": { "type": "integer", "minimum": 1 },
        "canvas": { "$ref": "#/$defs/rect" },
        "image_pixels": { "$ref": "#/$defs/rect" },
        "content": { "$ref": "#/$defs/rect" },
        "parameter_count": { "type": "integer", "minimum": 0 },
        "parameters": { "type": "object" },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slot" }
        }
      },
      "additionalProperties": true
    },
    "slot": {
      "type": "object",
      "required": ["index", "role", "clickable", "alternatives"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["input", "output", "catalyst", "render_only"] },
        "name": { "type": "string" },
        "clickable": { "type": "boolean" },
        "item_tag_equivalent": { "type": "string" },
        "rect": { "$ref": "#/$defs/rect" },
        "visual_rect": { "$ref": "#/$defs/rect" },
        "coordinates_available": { "type": "boolean" },
        "alternatives": {
          "type": "array",
          "items": { "type": "object", "required": ["type"], "additionalProperties": true }
        }
      },
      "additionalProperties": true
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
