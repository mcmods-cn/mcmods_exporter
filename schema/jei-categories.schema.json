{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mcmod.cn/schemas/mcmods-jei-categories-v7.json",
  "title": "MC百科 JEI 配方类别索引",
  "type": "object",
  "required": ["schema_version", "category_count", "recipe_count", "filter_summary", "categories", "recipes", "layout_sample_count"],
  "properties": {
    "schema_version": {"const": "mcmods-jei-categories/v7"},
    "category_count": {"type": "integer", "minimum": 0},
    "recipe_count": {"type": "integer", "minimum": 0},
    "filter_summary": {
      "type": "object",
      "required": ["policy", "discovered_recipe_presentations", "exported_recipe_presentations", "excluded_recipe_presentations", "excluded_by_reason", "excluded_by_recipe_type", "layout_sample_presentations", "template_only_recipe_presentations", "configured_excluded_recipe_type_ids", "configured_template_only_recipe_type_ids"],
      "properties": {
        "policy": {"const": "source_recipe_namespace_with_recipe_id_deduplication"},
        "discovered_recipe_presentations": {"type": "integer", "minimum": 0},
        "exported_recipe_presentations": {"type": "integer", "minimum": 0},
        "excluded_recipe_presentations": {"type": "integer", "minimum": 0},
        "excluded_by_reason": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "excluded_by_recipe_type": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          }
        },
        "layout_sample_presentations": {"type": "integer", "minimum": 0},
        "template_only_recipe_presentations": {"type": "integer", "minimum": 0},
        "configured_excluded_recipe_type_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "configured_template_only_recipe_type_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipe_type_id", "width", "height", "recipe_count", "exported_recipe_count", "template_count", "background_count", "template_collection", "recipe_collection", "image_scale", "canvas", "catalyst_count", "catalysts", "export_mode", "recipes_omitted", "source_recipe_count"],
        "properties": {
          "recipe_type_id": {"type": "string"},
          "title_component": {"type": "string"},
          "title_translation_key": {"type": "string"},
          "title_names": {"$ref": "#/$defs/names"},
          "width": {"type": "integer", "minimum": 0},
          "height": {"type": "integer", "minimum": 0},
          "recipe_count": {"type": "integer", "minimum": 0},
          "exported_recipe_count": {"type": "integer", "minimum": 0},
          "template_count": {"type": "integer", "minimum": 0},
          "background_count": {"type": "integer", "minimum": 0},
          "template_collection": {"type": "string"},
          "recipe_collection": {"type": "string"},
          "image_scale": {"type": "integer", "minimum": 1},
          "canvas": {"$ref": "#/$defs/rect"},
          "catalyst_count": {"type": "integer", "minimum": 0},
          "catalysts": {
            "type": "array",
            "items": {"$ref": "#/$defs/ingredient"}
          },
          "export_mode": {
            "enum": ["full", "templates_only"]
          },
          "recipes_omitted": {"type": "boolean"},
          "source_recipe_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "export_mode": {"const": "templates_only"}
              }
            },
            "then": {
              "properties": {
                "recipes_omitted": {"const": true},
                "recipe_count": {"const": 0},
                "exported_recipe_count": {"const": 0}
              }
            },
            "else": {
              "properties": {
                "recipes_omitted": {"const": false}
              }
            }
          }
        ]
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipe_type_id", "recipe_id", "recipe_id_source", "recipe_id_canonical", "source_mod_id", "source_mod_version", "source_mod_id_source", "origin_kind", "recipe_key", "template_collection", "recipe_collection", "layout_available", "background_available"],
        "properties": {
          "recipe_type_id": {"type": "string"},
          "recipe_id": {"type": "string"},
          "recipe_id_source": {
            "enum": ["minecraft_recipe", "jei_category", "generated_index"]
          },
          "recipe_id_canonical": {"type": "boolean"},
          "source_mod_id": {"type": "string"},
          "source_mod_version": {"type": "string"},
          "source_mod_id_source": {
            "enum": ["recipe_id_namespace", "recipe_type_namespace"]
          },
          "origin_kind": {
            "enum": ["registered_recipe", "jei_generated_recipe"]
          },
          "underlying_recipe_type_id": {"type": "string"},
          "layout_kind": {
            "enum": ["shaped", "shapeless", "not_applicable", "unknown"]
          },
          "ordered": {
            "type": ["boolean", "null"]
          },
          "layout_classification_source": {
            "enum": ["recipe_class", "serializer", "recipe_type", "unavailable"]
          },
          "recipe_key": {"type": "string"},
          "template_id": {"type": "string", "pattern": "^template_[0-9a-f]{16}$"},
          "template_collection": {"type": "string"},
          "recipe_collection": {"type": "string"},
          "background": {"type": "string"},
          "layout_available": {"type": "boolean"},
          "background_available": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "layout_sample_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "names": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ingredient": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "resource_location": {"type": "string"},
        "resource_location_unavailable": {"type": "boolean"},
        "unique_id": {"type": "string"},
        "unique_id_unavailable": {"type": "boolean"},
        "amount": {"type": "integer", "minimum": 0},
        "item": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "nbt_snbt": {"type": "string"},
        "translation_key": {"type": "string"},
        "names": {"$ref": "#/$defs/names"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
